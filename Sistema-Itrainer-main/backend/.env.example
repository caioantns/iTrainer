NODE_ENV=development
PORT=3010

# Postgres
# DATABASE_URL=postgres://itrainer_user:senha@localhost:5432/itrainer
PGHOST=localhost
PGPORT=5432
PGUSER=itrainer_user
PGPASSWORD=dev-pg-pass
PGDATABASE=itrainer
PGSSL=false

# CORS — aceita CSV (vargas dominios separados por virgula). Em prod, valor real obrigatorio.
CORS_ORIGIN=http://localhost:3000

# JWT — em producao GERAR via: openssl rand -base64 48 (>= 32 chars)
JWT_SECRET=dev-secret-do-not-use-in-prod-please-generate-real-one
JWT_EXPIRES_IN=15m
JWT_ISSUER=itrainer-api
JWT_AUDIENCE=itrainer-app

# Refresh token (httpOnly cookie). 30 dias.
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.seudominio.com  # so prod, se subdominios diferentes

# Base URL do frontend p/ links em emails (password reset etc)
APP_BASE_URL=http://localhost:3000

# SMTP — se vazio em dev, emails caem no console.log. Obrigatorio em prod.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=iTrainer <no-reply@itrainer.local>

# Asaas (sandbox)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
